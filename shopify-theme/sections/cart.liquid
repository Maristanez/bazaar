{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<section class="cart-shell">
  <div class="cart-shell__header">
    <p>Your trail bag</p>
    <h1>{{ 'cart.title' | t }}</h1>
  </div>

  {% if cart.item_count > 0 %}
    <form class="cart-shell__layout" action="{{ routes.cart_url }}" method="post">
      <div class="cart-shell__items">
        {% for item in cart.items %}
          <article class="cart-item">
            <div class="cart-item__image">
              {% render 'image', image: item.image, url: item.url %}
            </div>

            <div class="cart-item__main">
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {% unless item.variant.title == 'Default Title' %}
                <p class="cart-item__variant">{{ item.variant.title }}</p>
              {% endunless %}
              <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>

            <label class="cart-item__quantity">
              <span>Qty</span>
              <input type="number" name="updates[]" min="0" value="{{ item.quantity }}">
            </label>
          </article>
        {% endfor %}
      </div>

      <aside class="cart-summary" aria-label="Order summary">
        <p class="cart-summary__kicker">Secure Shopify checkout</p>
        <h2>Order summary</h2>

        <div class="cart-summary__row">
          <span>Items</span>
          <strong>{{ cart.item_count }}</strong>
        </div>
        <div class="cart-summary__row">
          <span>Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>

        <p class="cart-summary__note">
          AI deal codes are single-use and checked again by Shopify at checkout.
        </p>

        <div class="cart-summary__actions">
          <input type="submit" value="{{ 'cart.update' | t }}">
          <input type="submit" name="checkout" value="{{ 'cart.checkout' | t }}">
        </div>
      </aside>
    </form>
  {% else %}
    <div class="cart-shell__empty">
      <h2>Your cart is ready for the first piece.</h2>
      <p>Pick a product, ask the AI shopkeeper for a fair offer, or add something at list price.</p>
      <a href="{{ routes.all_products_collection_url }}">Shop the collection</a>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .cart-shell {
    --spruce: #064e3b;
    --lichen: #e7f2e8;
    --bone: #fbf7ef;
    --ink: #17211c;
    --trail: #ea580c;
    min-height: 65svh;
    padding: clamp(2rem, 6vw, 5rem) var(--page-margin) clamp(4rem, 8vw, 7rem);
    background:
      radial-gradient(circle at 92% 0%, rgb(234 88 12 / 12%), transparent 24rem),
      linear-gradient(180deg, #fbf7ef 0%, #f4efe6 100%);
    color: var(--ink);
  }

  .cart-shell__header {
    display: grid;
    gap: 0.4rem;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .cart-shell__header p,
  .cart-summary__kicker {
    color: var(--trail);
    font-weight: 900;
  }

  .cart-shell__header h1 {
    color: var(--spruce);
    font-size: clamp(3rem, 7vw, 6.5rem);
    letter-spacing: -0.07em;
    line-height: 0.92;
  }

  .cart-shell__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 25rem);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }

  .cart-shell__items {
    display: grid;
    gap: 0.9rem;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) minmax(5rem, auto);
    gap: 1rem;
    align-items: center;
    padding: 0.85rem;
    border: 1px solid rgb(6 78 59 / 12%);
    border-radius: 1.2rem;
    background: rgb(255 255 255 / 82%);
    box-shadow: 0 18px 60px rgb(23 33 28 / 7%);
  }

  .cart-item__image {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 0.9rem;
    background: var(--lichen);
  }

  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__main {
    display: grid;
    gap: 0.25rem;
  }

  .cart-item__title {
    color: var(--spruce);
    font-size: 1.1rem;
    font-weight: 900;
    text-decoration: none;
  }

  .cart-item__variant,
  .cart-item__price {
    color: #526159;
    font-size: 0.92rem;
  }

  .cart-item__remove {
    width: fit-content;
    color: #9a3412;
    font-size: 0.86rem;
    font-weight: 800;
    text-underline-offset: 0.22rem;
  }

  .cart-item__quantity {
    display: grid;
    gap: 0.35rem;
    color: var(--spruce);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .cart-item__quantity input {
    width: 5.2rem;
    min-height: 2.75rem;
    border: 1px solid rgb(6 78 59 / 18%);
    border-radius: 0.8rem;
    padding: 0 0.75rem;
    background: #fff;
  }

  .cart-summary,
  .cart-shell__empty {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgb(6 78 59 / 14%);
    border-radius: 1.35rem;
    background: #fff;
    box-shadow: 0 24px 80px rgb(23 33 28 / 10%);
  }

  .cart-summary {
    position: sticky;
    top: 1.25rem;
  }

  .cart-summary h2,
  .cart-shell__empty h2 {
    color: var(--spruce);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .cart-summary__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    border-top: 1px solid #e5e7eb;
  }

  .cart-summary__row strong {
    color: var(--spruce);
  }

  .cart-summary__note,
  .cart-shell__empty p {
    color: #526159;
    line-height: 1.55;
  }

  .cart-summary__actions {
    display: grid;
    gap: 0.65rem;
  }

  .cart-summary__actions input,
  .cart-shell__empty a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    text-decoration: none;
  }

  .cart-summary__actions input:first-child {
    border: 1px solid rgb(6 78 59 / 18%);
    background: #fff;
    color: var(--spruce);
  }

  .cart-summary__actions input[name='checkout'],
  .cart-shell__empty a {
    background: var(--trail);
    color: #fff;
  }

  .cart-shell__empty {
    max-width: 44rem;
  }

  @media (max-width: 850px) {
    .cart-shell__layout {
      grid-template-columns: 1fr;
    }

    .cart-summary {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .cart-item {
      grid-template-columns: 5.5rem 1fr;
    }

    .cart-item__quantity {
      grid-column: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
