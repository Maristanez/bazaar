{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  Changing a quantity posts to the Cart API and re-renders this section, so the
  line prices and the order summary always match the inputs. Without JavaScript
  the "Update cart" button does the same through a normal form post.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<section class="cart-shell full-width" data-cart data-cart-section="{{ section.id }}" data-cart-change-url="{{ routes.cart_change_url }}">
  <div class="cart-shell__inner">
    <h1>{{ 'cart.title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <form class="cart-shell__layout" action="{{ routes.cart_url }}" method="post">
        <div class="cart-shell__items">
          {% for item in cart.items %}
            <article class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}" aria-label="View {{ item.product.title | escape }}">
                {% if item.image %}
                  {{ item.image | image_url: width: 320, height: 320, crop: 'center' | image_tag: loading: 'lazy', alt: item.product.title }}
                {% endif %}
              </a>

              <div class="cart-item__main">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="cart-item__unit">{{ item.final_price | money }} each</p>
                {% for discount in item.line_level_discount_allocations %}
                  <p class="cart-item__discount">{{ discount.discount_application.title }} · −{{ discount.amount | money }}</p>
                {% endfor %}
                <a class="cart-item__remove" href="{{ item.url_to_remove }}" data-cart-remove="{{ forloop.index }}">{{ 'cart.remove' | t }}</a>
              </div>

              <div class="cart-item__side">
                <div class="cart-item__stepper">
                  <button type="button" data-cart-step="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10"/></svg>
                  </button>
                  <label class="visually-hidden" for="Quantity-{{ section.id }}-{{ forloop.index }}">Quantity of {{ item.product.title | escape }}</label>
                  <input
                    id="Quantity-{{ section.id }}-{{ forloop.index }}"
                    type="number"
                    name="updates[]"
                    min="0"
                    inputmode="numeric"
                    value="{{ item.quantity }}"
                    data-cart-quantity="{{ forloop.index }}"
                  >
                  <button type="button" data-cart-step="1" aria-label="Increase quantity of {{ item.product.title | escape }}">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10"/></svg>
                  </button>
                </div>
                <p class="cart-item__price">
                  {% if item.original_line_price != item.final_line_price %}
                    <s>{{ item.original_line_price | money }}</s>
                  {% endif %}
                  {{ item.final_line_price | money }}
                </p>
              </div>
            </article>
          {% endfor %}
        </div>

        <aside class="cart-summary" aria-label="Order summary">
          <h2>Order summary</h2>

          <div class="cart-summary__rows">
            <div class="cart-summary__row">
              <span>Items</span>
              <strong>{{ cart.item_count }}</strong>
            </div>
            {% for discount in cart.cart_level_discount_applications %}
              <div class="cart-summary__row">
                <span>{{ discount.title }}</span>
                <strong>−{{ discount.total_allocated_amount | money }}</strong>
              </div>
            {% endfor %}
            <div class="cart-summary__row cart-summary__row--total">
              <span>Subtotal</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>
          </div>

          <p class="cart-summary__note">Shipping and tax are worked out at checkout.</p>

          <div class="cart-summary__actions">
            <input type="submit" name="checkout" value="{{ 'cart.checkout' | t }}">
            <input class="cart-summary__update" type="submit" value="{{ 'cart.update' | t }}">
          </div>

          <p class="cart-summary__note">
            Secure Shopify checkout. AI deal codes are single-use and checked again by Shopify at checkout.
          </p>
          <p class="cart-summary__status" role="status" aria-live="polite" data-cart-status></p>
        </aside>
      </form>
    {% else %}
      <div class="cart-shell__empty">
        <h2>Your cart is ready for the first piece.</h2>
        <p>Pick a product, ask the AI shopkeeper for a fair offer, or add something at list price.</p>
        <a href="{{ routes.all_products_collection_url }}">Shop the collection</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cart-shell {
    min-height: 65svh;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--th-gutter) clamp(4rem, 8vw, 7rem);
    background: var(--th-cream);
    color: var(--th-bark);
  }
  .cart-shell__inner { width: min(100%, var(--th-shelf-width)); margin: 0 auto; }
  .cart-shell h1 {
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
    color: var(--th-teal);
    font-family: var(--th-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    line-height: 1.02;
  }

  .cart-shell__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 25rem);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    transition: opacity 200ms ease;
  }
  .cart-shell[aria-busy='true'] .cart-shell__layout { opacity: 0.6; }

  .cart-shell__items { display: grid; }
  .cart-item {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding-block: 1.25rem;
    border-top: 1px solid rgb(47 22 4 / 14%);
  }
  .cart-item:first-child { border-top: 0; padding-top: 0; }

  .cart-item__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border: 5px solid #fff;
    border-radius: 1rem;
    background: #f1e8d8;
    transform: rotate(-2deg);
    box-shadow: 0 12px 20px -14px rgb(47 22 4 / 55%), 0 2px 4px rgb(47 22 4 / 12%);
  }
  .cart-item:nth-child(even) .cart-item__image { transform: rotate(1.5deg); }
  .cart-item__image img { width: 100%; height: 100%; object-fit: cover; }

  .cart-item__main { display: grid; gap: 0.2rem; justify-items: start; }
  .cart-item__title {
    color: var(--th-bark);
    font-family: var(--th-display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.15;
    text-decoration: none;
  }
  .cart-item__title:hover { text-decoration: underline; text-decoration-color: var(--th-coral); text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  .cart-item__variant, .cart-item__unit { color: var(--th-bark-soft); font-size: 0.95rem; }
  .cart-item__discount { color: var(--th-teal); font-size: 0.9rem; font-weight: 700; }
  .cart-item__remove {
    margin-top: 0.35rem;
    min-height: 1.75rem;
    color: var(--th-bark-soft);
    font-size: 0.9rem;
    font-weight: 700;
    text-underline-offset: 0.22rem;
  }
  .cart-item__remove:hover { color: var(--th-bark); }

  .cart-item__side { display: grid; gap: 0.6rem; justify-items: end; }
  .cart-item__stepper {
    display: flex;
    align-items: center;
    border: 2px solid var(--th-teal);
    border-radius: 999px;
    background: #fff;
  }
  .cart-item__stepper button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--th-teal);
    cursor: pointer;
  }
  .cart-item__stepper button:hover { background: var(--th-sky); }
  .cart-item__stepper svg { width: 1rem; height: 1rem; stroke: currentColor; stroke-width: 2; stroke-linecap: round; fill: none; }
  .cart-item__stepper input {
    width: 2.75rem;
    min-height: 2.75rem;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    color: var(--th-bark);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }
  .cart-item__stepper input::-webkit-outer-spin-button,
  .cart-item__stepper input::-webkit-inner-spin-button { appearance: none; margin: 0; }
  .cart-item__price {
    font-family: var(--th-display);
    font-weight: 600;
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }
  .cart-item__price s { margin-right: 0.35rem; color: var(--th-bark-soft); font-weight: 500; font-size: 0.95rem; }

  .cart-summary,
  .cart-shell__empty {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: 1.25rem;
    background: var(--th-paper);
    box-shadow: 0 24px 40px -28px rgb(47 22 4 / 50%);
  }
  .cart-summary { position: sticky; top: 5.75rem; }

  .cart-summary h2,
  .cart-shell__empty h2 {
    color: var(--th-teal);
    font-family: var(--th-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.1;
  }

  .cart-summary__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid rgb(47 22 4 / 12%);
    font-variant-numeric: tabular-nums;
  }
  .cart-summary__row:first-child { border-top: 0; }
  .cart-summary__row--total strong { font-family: var(--th-display); font-weight: 600; font-size: 1.6rem; }

  .cart-summary__note,
  .cart-shell__empty p { color: var(--th-bark-soft); font-size: 0.92rem; line-height: 1.55; }
  .cart-summary__status:empty { display: none; }
  .cart-summary__status { color: #a3261b; font-size: 0.92rem; font-weight: 700; }

  .cart-summary__actions { display: grid; gap: 0.65rem; }
  .cart-summary__actions input,
  .cart-shell__empty a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.15rem;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    font: inherit;
    font-family: var(--th-display);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .cart-summary__actions input[name='checkout'],
  .cart-shell__empty a {
    padding-inline: 1.65rem;
    background: var(--th-coral);
    color: var(--th-bark);
    box-shadow: 0 10px 22px -12px rgb(47 22 4 / 70%);
  }
  .cart-summary__update { border: 2px solid var(--th-teal) !important; background: transparent; color: var(--th-teal); }
  .cart-shell[data-cart-live] .cart-summary__update { display: none; }

  .cart-shell__empty { max-width: 44rem; justify-items: start; }

  @media (max-width: 850px) {
    .cart-shell__layout { grid-template-columns: 1fr; }
    .cart-summary { position: static; }
  }
  @media (max-width: 560px) {
    .cart-item { grid-template-columns: 5rem minmax(0, 1fr); align-items: start; }
    .cart-item__side { grid-column: 1 / -1; grid-template-columns: auto 1fr; align-items: center; justify-items: end; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-shell__layout { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var timer;

    function shell() { return document.querySelector('[data-cart]'); }

    function change(line, quantity) {
      var cart = shell();
      if (!cart) return;
      var sectionId = cart.getAttribute('data-cart-section');
      cart.setAttribute('aria-busy', 'true');

      fetch(cart.getAttribute('data-cart-change-url') + '.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ line: line, quantity: quantity, sections: [sectionId], sections_url: window.location.pathname })
      })
        .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
        .then(function (result) {
          if (!result.ok) throw new Error(result.data.description || result.data.message || 'That quantity is not available.');
          var html = result.data.sections && result.data.sections[sectionId];
          if (!html) return window.location.reload();
          var next = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-cart]');
          var focused = document.activeElement && document.activeElement.id;
          cart.innerHTML = next.innerHTML;
          if (focused && document.getElementById(focused)) document.getElementById(focused).focus();
          badge(result.data.item_count);
        })
        .catch(function (error) {
          var status = cart.querySelector('[data-cart-status]');
          if (status) status.textContent = error.message;
        })
        .then(function () {
          cart.removeAttribute('aria-busy');
        });
    }

    // Keeps the header cart count in step with the cart page.
    function badge(count) {
      var link = document.querySelector('.site-header .header__icons > a');
      if (!link) return;
      var sup = link.querySelector('sup');
      if (count > 0) {
        if (!sup) { sup = document.createElement('sup'); link.insertBefore(sup, link.firstChild); }
        sup.textContent = count;
      } else if (sup) {
        sup.remove();
      }
    }

    function queue(input) {
      var quantity = Math.max(0, parseInt(input.value, 10) || 0);
      input.value = quantity;
      clearTimeout(timer);
      timer = setTimeout(function () { change(Number(input.getAttribute('data-cart-quantity')), quantity); }, 350);
    }

    document.addEventListener('click', function (event) {
      var step = event.target.closest('[data-cart-step]');
      if (step) {
        var input = step.parentNode.querySelector('[data-cart-quantity]');
        input.value = Math.max(0, (parseInt(input.value, 10) || 0) + Number(step.getAttribute('data-cart-step')));
        return queue(input);
      }
      var remove = event.target.closest('[data-cart-remove]');
      if (remove) {
        event.preventDefault();
        change(Number(remove.getAttribute('data-cart-remove')), 0);
      }
    });

    document.addEventListener('change', function (event) {
      if (event.target.matches('[data-cart-quantity]')) queue(event.target);
    });

    var cart = shell();
    if (cart) cart.setAttribute('data-cart-live', '');
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
