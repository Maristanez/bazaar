{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: 'Satoshi', {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: calc(77.5rem + 2 * var(--th-gutter));
    --page-margin: var(--th-gutter);
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    {% # Store look and feel, docs/SPEC.md §12. The fonts are declared in critical.css. %}
    --th-teal: #004c4c;
    --th-teal-deep: #003838;
    --th-sky: #ccffff;
    --th-coral: #f3675a;
    --th-sun: #f6d809;
    --th-bark: #2f1604;
    --th-bark-soft: #6b4a33;
    --th-cream: #fdf3e3;
    --th-paper: #fffaf0;
    --th-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --th-display: 'Fredoka', ui-rounded, system-ui, sans-serif;
    --th-gutter: clamp(1rem, 5vw, 4.5rem);
    --th-shelf-width: 77.5rem;
  }

  html { scrollbar-color: var(--th-teal) var(--th-cream); }
  html body {
    background-color: var(--th-cream);
    color: var(--th-bark);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
.shopify-section-group-footer-group { margin-top: auto; }

  {% # Plain pages (search, 404, pages, blog): headings, copy and links that sit straight in a section. %}
  .shopify-section > h1:not([class]) {
    margin-block: clamp(2.5rem, 6vw, 4.5rem) 1.25rem;
    color: var(--th-teal);
    font-family: var(--th-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .shopify-section > p:not([class]) { max-width: 65ch; margin-bottom: 1rem; }
  .shopify-section > :is(p, div):not([class]) a { color: var(--th-teal); font-weight: 700; text-underline-offset: 0.22rem; }
  .shopify-section > a:not([class]) {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 3rem;
    margin-block: 0.75rem 6rem;
    padding: 0 1.65rem;
    border-radius: 999px;
    background: var(--th-coral);
    color: var(--th-bark);
    font-family: var(--th-display);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .shopify-section > :last-child:is(p, div):not([class], .full-width) { margin-bottom: 6rem; }

  ::selection { background: var(--th-sun); color: var(--th-bark); }
  html body :is(a, button, input, select):focus-visible { outline-color: var(--th-sun); }
{% endstyle %}
