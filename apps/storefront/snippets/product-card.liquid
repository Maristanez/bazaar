{% comment %}
  Compact, reusable product card for collection and home-page grids.
{% endcomment %}

<article class="product-card">
  <a class="product-card__image" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 720, height: 900, crop: 'center' | image_tag: loading: 'lazy', widths: '360, 540, 720' }}
    {% else %}
      <span class="product-card__placeholder" aria-hidden="true">{{ product.title | slice: 0, 1 }}</span>
    {% endif %}
  </a>
  <div class="product-card__details">
    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    <p class="product-card__price">{{ product.price | money }}</p>
  </div>
</article>

{% stylesheet %}
  .product-card {
    display: grid;
    gap: 0.8rem;
  }

  .product-card__image {
    display: grid;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #d7eadf;
    color: #064e3b;
  }

  .product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .product-card__image:hover img { transform: scale(1.04); }

  .product-card__placeholder {
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 700;
  }

  .product-card__details { display: grid; gap: 0.25rem; }
  .product-card h3 { font-size: 1rem; line-height: 1.3; }
  .product-card a { color: inherit; text-decoration: none; }
  .product-card__price { font-weight: 700; }
{% endstylesheet %}
