<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    <div
      class="ai-chat"
      data-ai-chat
      data-ai-chat-endpoint="{{ settings.ai_chat_endpoint | escape }}"
    >
      <section
        id="ai-chat-panel"
        class="ai-chat__panel"
        role="region"
        aria-labelledby="ai-chat-title"
        hidden
      >
        <div class="ai-chat__header">
          <span class="ai-chat__sticker ai-chat__sticker--head" data-ai-chat-sticker="head" aria-hidden="true"></span>
          <div class="ai-chat__who">
            <h2 id="ai-chat-title">Juniper</h2>
            <p data-ai-chat-mode>Trailhead's AI shopkeeper. Takes offers.</p>
          </div>
          <div class="ai-chat__header-actions">
            <button
              class="ai-chat__icon-button ai-chat__voice-toggle"
              type="button"
              data-ai-chat-voice-toggle
              aria-pressed="false"
              aria-label="Turn spoken replies on"
              hidden
            ></button>
            <button class="ai-chat__icon-button ai-chat__close" type="button" data-ai-chat-close aria-label="Close chat">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
        </div>

        <div class="ai-chat__messages" data-ai-chat-messages aria-live="polite">
          <p class="ai-chat__message ai-chat__message--bot" data-ai-chat-welcome>
            Hi, make me an offer or ask for a small bundle perk. Try one of the prompts below.
          </p>
        </div>

        <div class="ai-chat__foot">
          <div class="ai-chat__prompts" data-ai-chat-prompts aria-label="Suggested chat prompts">
            <button type="button" data-ai-chat-prompt="I'm buying two pairs. What can you do?">I'm buying two</button>
            <button type="button" data-ai-chat-prompt="Could you give me a student discount?">Student discount</button>
            <button type="button" data-ai-chat-prompt="If I buy today, could you add socks as a gift?">Gift me socks</button>
          </div>

          <div class="ai-chat__listen" data-ai-chat-listen role="status" hidden>
            <span>Listening</span>
            <span class="ai-chat__wave" data-ai-chat-wave aria-hidden="true"></span>
            <button class="ai-chat__listen-stop" type="button" data-ai-chat-listen-stop aria-label="Stop and send"><i></i></button>
          </div>

          <form class="ai-chat__form" data-ai-chat-form>
            <label class="visually-hidden" for="ai-chat-input">Message the Trailhead shopkeeper</label>
            <input
              id="ai-chat-input"
              type="text"
              name="message"
              autocomplete="off"
              placeholder="Make an offer..."
              data-ai-chat-input
            >
            <button
              class="ai-chat__icon-button ai-chat__mic"
              type="button"
              data-ai-chat-mic
              aria-label="Talk instead of typing"
              title="Talk instead of typing"
              hidden
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg>
            </button>
            <button class="ai-chat__icon-button ai-chat__send" type="submit" aria-label="Send">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h13M12 6l6 6-6 6" /></svg>
            </button>
          </form>

          <p class="ai-chat__source">Deal opens Shopify Checkout, where you pay.</p>
        </div>
      </section>

      <button
        class="ai-chat__launcher"
        type="button"
        aria-label="Make an offer: open the Trailhead shopkeeper chat"
        aria-expanded="false"
        aria-controls="ai-chat-panel"
        data-ai-chat-toggle
      >
        <span class="ai-chat__sticker ai-chat__sticker--launcher" data-ai-chat-sticker="launcher" aria-hidden="true"></span>
        <span>Make an offer</span>
      </button>
    </div>

    <script type="application/json" data-ai-chat-products>
      [
        {%- for product in collections.all.products -%}
          {
            "productId": {{ product.id | json }},
            "handle": {{ product.handle | json }},
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "type": {{ product.type | json }},
            "price": {{ product.price | money_without_trailing_zeros | json }},
            "listPrice": {{ product.price | json }},
            "available": {{ product.available | json }},
            "selectedVariantId": {{ product.selected_or_first_available_variant.id | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
    <script src="{{ 'chat-demo.js' | asset_url }}" defer></script>

    {% sections 'footer-group' %}
  </body>
</html>
