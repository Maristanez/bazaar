# Server side Supabase connection. Never expose the secret key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
SUPABASE_PUBLISHABLE_KEY=your-browser-publishable-key

# Shopify Admin API. The server exchanges client id/secret for a 24h access
# token, or uses SHOPIFY_ADMIN_ACCESS_TOKEN directly if you prefer a custom-app
# admin token.
SHOPIFY_SHOP=b8wzw0-h3
SHOPIFY_API_VERSION=2026-01
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_or_token_exchange_result

# Server side AI only. Backboard routes the selected OpenAI model. Never put
# these values in Shopify theme code.
BACKBOARD_API_KEY=your-backboard-api-key
BACKBOARD_ASSISTANT_ID=your-backboard-assistant-id
BACKBOARD_MODEL_PROVIDER=openai
BACKBOARD_MODEL_NAME=gpt-5.6-terra
BACKBOARD_MEMORY_MODE=Auto
BACKBOARD_TIMEOUT_MS=6500

# Optional server side ElevenLabs voice mode. The API key never enters the
# Shopify theme. Voice input uses Scribe and bot replies use streamed TTS.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=tapn1QwocNXk3viVSowa
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# Legacy names remain accepted while deployments migrate.
# SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
# SUPABASE_ANON_KEY=your-browser-anon-key

# Optional. Comma-separated extra origins allowed to call the shopper API (the Shopify store domain is allowed already).
ALLOWED_ORIGINS=
