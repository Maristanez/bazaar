{
  "name": "bazaar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "sh -c '[ -f apps/web/dist/index.html ] || pnpm --dir apps/web build; pnpm --dir apps/server start'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel typecheck",
    "test:props": "vitest run packages/engine/src/properties.test.ts",
    "build": "pnpm --dir apps/web build"
  },
  "devDependencies": {
    "@bazaar/contracts": "workspace:*",
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
